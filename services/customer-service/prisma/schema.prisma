generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Membership {
  mid   Int    @id @default(autoincrement())
  mname String @unique @db.VarChar(50)
  score Int

  customers Customer[]

  @@map("memberships")
}

model Customer {
  uid      Int    @id
  fullname String @db.VarChar(100)
  mid      Int

  membership Membership @relation(fields: [mid], references: [mid])

  @@map("customers")
}