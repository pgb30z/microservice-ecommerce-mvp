generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Order {
  oid          Int           @id @default(autoincrement())
  uid          Int
  discount     Decimal       @default(0) @db.Decimal(10, 2)
  total_amount Decimal       @db.Decimal(14, 2)
  created_at   DateTime      @default(now())

  details      OrderDetail[]

  @@index([uid])
  @@map("orders")
}

model OrderDetail {
  oid        Int
  pid        Int
  qty        Int
  unit_price Decimal @db.Decimal(14, 2)

order Order @relation(fields: [oid], references: [oid], onDelete: Cascade)

  @@id([oid, pid])
  @@map("order_details")
}
model OutboxEvent {
  id             String    @id @default(uuid())
  aggregate_type String    @db.VarChar(50)
  aggregate_id   String    @db.VarChar(100)
  event_type     String    @db.VarChar(100)
  payload        Json

  status         String    @default("PENDING") @db.VarChar(20)

  created_at     DateTime  @default(now())
  published_at   DateTime?

  @@index([status, created_at])
  @@map("outbox_events")
}